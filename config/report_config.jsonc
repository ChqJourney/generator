      "template_field": "photometric_data_table",
      "source_field": "extracted_data.photometric_data_table",
      "table_template_path": "report_templates/tables/photometric_table_template.docx",
      "type": "table",
      "row_strategy": "fixed_rows",
      "header_rows": 2,
      "skip_columns": [
        0,
        1
      ],
      "text_insert": [
        {
          "column": 0,
          "row": 2,
          "value": "extracted_data.light_source_type"
        }
      ],
      "transformations": [
        {
          "type": "calculate",
          "column": 4,
          "operation": "formula=D{row}/B{row}",
          "decimal": 1,
          "insert": true
        },
        {
          "type": "calculate",
          "column": 4,
          "operation": "average",
          "function": "lambda x: f'{x:.2f}'"
        },
        {
          "type": "calculate",
          "column": 0,
          "operation": "average",
          "function": "lambda x: f'{x:.2f}'"
        },
        {
