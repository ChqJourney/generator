    // verdicts - 使用通用条款判定函数
    {
      "template_field": "v.1.a",
      "source_field": "calculated_data.v.1.a",
      "type": "text",
      "function": "evaluate_clause",
      "args": [
        "metadata.containing_product.value",
        "metadata.light_sources.value"
      ],
      "clause_config": {
        "clause_id": "v.1.a",
        "param_names": ["containing_product", "light_sources"],
        "rules": [
          {
            "condition": "containing_product == 'true' AND light_sources == 'true'",
            "result": "Pass"
          },
          {
            "condition": "containing_product == 'false'",
            "result": "N/A"
          }
        ],
        "default": "Fail"
      }
    },
    {
      "template_field": "v.1.b.1",
      "source_field": "calculated_data.v.1.b.1",
      "type": "text",
      "function": "evaluate_clause",
      "args": [
        "metadata.replaceable_LED.value",
        "metadata.replace_by_pro.value",
        "metadata.non_replaceable.value"
      ],
      "clause_config": {
        "clause_id": "v.1.b.1",
        "param_names": ["replaceable_LED", "replace_by_pro", "non_replaceable"],
        "rules": [
          {
            "condition": "replaceable_LED == 'true'",
            "result": "Pass"
          },
          {
            "condition": "non_replaceable == 'true'",
            "result": "N/A"
          },
          {
            "condition": "replaceable_LED == 'false'",
            "result": "N/A"
          }
        ],
        "default": "Fail"
      }
    },
